{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeReviewReport",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fileName",
          "location",
          "ruleId",
          "blockLevel",
          "codeSnippet",
          "affectedScope",
          "suggestion"
        ],
        "additionalProperties": false,
        "properties": {
          "fileName": {
            "type": "string",
            "description": "相对于仓库根目录的文件路径"
          },
          "location": {
            "type": "string",
            "description": "问题位置，格式为 文件路径:行号"
          },
          "ruleId": {
            "type": "string",
            "description": "规则编号，如 BASE-00001、JCR-00001、SQL-00001 或 P3C 规则名"
          },
          "blockLevel": {
            "type": "string",
            "enum": ["Blocker", "Critical", "Major", "Minor"],
            "description": "问题级别"
          },
          "codeSnippet": {
            "type": "string",
            "description": "问题代码片段"
          },
          "affectedScope": {
            "type": "string",
            "description": "影响范围描述"
          },
          "suggestion": {
            "type": "string",
            "description": "修复建议"
          }
        }
      }
    }
  }
}
